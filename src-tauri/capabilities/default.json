{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口与设置窗口的最小权限集（项目规则：最小权限）",
  "windows": ["main", "settings"],
  "permissions": [
    "core:default",
    "dialog:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-close"
  ]
}
